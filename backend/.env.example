# Copy to `.env` and adjust. Never commit the real `.env`.

# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backend

# --- Redis (Celery /0, cache+default /1, streams /2, channels /3) ------------
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/1
REDIS_STREAMS_URL=redis://localhost:6379/2
REDIS_KEY_PREFIX=backend
REDIS_CHANNELS_URL=redis://localhost:6379/3

# --- WebSockets -------------------------------------------------------------
USE_WEBSOCKETS=True
# WS_MAX_CONNECTIONS_PER_USER=5
# WS_MAX_MESSAGE_BYTES=65536

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Throttling -------------------------------------------------------------
# DRF_THROTTLE_ANON=100/min
# DRF_THROTTLE_USER=1000/min
# DRF_THROTTLE_REGISTER=5/min
# DRF_THROTTLE_TOKEN_REFRESH=30/min
# DRF_THROTTLE_OTP_REQUEST=10/min
# DRF_THROTTLE_OTP_VERIFY=30/min

# --- OTP / SMS --------------------------------------------------------------
# OTP_CODE_TTL_SECONDS=120
# OTP_MAX_ATTEMPTS=5
# OTP_PHONE_HOURLY_LIMIT=5
# OTP_IP_HOURLY_LIMIT=20
# Log generated codes in the web server terminal (development only; on by default).
# OTP_LOG_CODES=True
# SMS_DRIVER=log

# --- Frontend / Email -------------------------------------------------------
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@example.com
# Development uses console backend (see config/settings/development.py).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (production).
# Development allows all origins automatically.
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
# CORS_ALLOW_CREDENTIALS=True

# --- Health -----------------------------------------------------------------
# When set, /health/ and /health/ready/ require header X-Health-Token.
# HEALTH_CHECK_TOKEN=

# --- Sentry (optional) ------------------------------------------------------
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Production only --------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# POSTGRES_PASSWORD=  # required with docker-compose.prod.yml
# REDIS_PASSWORD=     # required with docker-compose.prod.yml

# --- Object storage (S3 / MinIO) — production media -------------------------
# Leave AWS_STORAGE_BUCKET_NAME empty to keep local filesystem storage.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=           # e.g. http://minio:9000 for MinIO
# AWS_S3_CUSTOM_DOMAIN=          # optional CDN / public domain
# AWS_QUERYSTRING_AUTH=True
# FILES_SIGNED_URL_TTL_SECONDS=300
# FILES_PUBLIC_BASE_URL=         # optional absolute base for content URLs without request
# DATA_UPLOAD_MAX_MEMORY_SIZE=27262976
# FILE_UPLOAD_MAX_MEMORY_SIZE=27262976
# DRF_THROTTLE_FILE_UPLOAD=30/min

